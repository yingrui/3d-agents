# 阿里云百炼（Model Studio）配置
# 控制台：https://bailian.console.aliyun.com/ → API-KEY → 创建（sk- 开头）
DASHSCOPE_API_KEY=

# 可选：业务空间 ID。填了就走 workspace 专属域名，留空走 legacy 域名
# 查看方式：百炼控制台首页右上角图标 → 业务空间 ID
DASHSCOPE_WORKSPACE_ID=

# 可选：TTS 模型与音色，留空用默认值
# 注意：qwen3-tts-flash 更便宜但不返回字级时间戳，数字人口型不要用
DASHSCOPE_TTS_MODEL=qwen-audio-3.1-tts-flash
DASHSCOPE_TTS_VOICE=longanhuan_v3.1

# ---------------------------------------------------------------------------
# 对话模型：OpenAI 兼容协议（这里默认 DeepSeek）
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# 语音识别（Fun-ASR 实时）与 VAD
# ---------------------------------------------------------------------------
ASR_MODEL=fun-asr-realtime
ASR_SAMPLE_RATE=16000
# 本地 VAD 的 RMS 门限，安静房间 0.02 左右；太灵敏会把她自己的回声当人声
VAD_THRESHOLD=0.02
# 静音多久算「说完了」，单位毫秒，400~800 比较自然
VAD_SILENCE_MS=700
# 领域词表：帮 ASR 认准角色名（可留空）
ASR_CONTEXT=小岚
